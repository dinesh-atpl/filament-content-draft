{
    "name": "konectar/filament-content-draft",
    "description": "Filament 5.x plugin for auto-saving and recovering form content drafts.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Konectar Team"
        }
    ],
    "require": {
        "php": "^8.2",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.9|^2.0"
    },
    "autoload": {
        "psr-4": {
            "Konectar\\FilamentContentDraft\\": "src/",
            "Konectar\\FilamentContentDraft\\Database\\Factories\\": "database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Konectar\\FilamentContentDraft\\ContentDraftServiceProvider"
            ]
        }
    }
}
